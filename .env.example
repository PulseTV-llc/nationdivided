# ─────────────────────────────────────────────────────────────
#  Nation Divided — environment variables
#  Copy to .env.local for development. In Vercel, set these under
#  Project → Settings → Environment Variables.
#  Only NEXT_PUBLIC_* values are ever sent to the browser.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, OG images, admin links in emails)
NEXT_PUBLIC_SITE_URL=https://nationdivided.example

# ── Required in production ────────────────────────────────────

# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS…).
# Local quick start without Postgres: DATABASE_URL=pglite://.data/pglite
DATABASE_URL=postgres://user:password@host:5432/nation_divided

# 48+ random characters. Salts rate-limit keys and signs dev upload tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# ── Casting video uploads (optional — the form works without them) ──
# Any S3-compatible PRIVATE bucket. The browser uploads directly with a
# 15-minute signed URL. Configure the bucket's CORS to allow PUT from your
# site origin, and a lifecycle rule expiring "casting/pending/" after 2 days.
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
# Cloudflare R2 example: https://<account-id>.r2.cloudflarestorage.com  (omit for AWS S3)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "true" for MinIO / some S3-compatible providers
S3_FORCE_PATH_STYLE=false
# Local development only: STORAGE_DRIVER=local stores uploads in .data/uploads

# ── Email (optional — Resend) ────────────────────────────────
# Without these, applications are still saved; applicants simply aren't told an email was sent.
RESEND_API_KEY=
EMAIL_FROM="Nation Divided Casting <casting@yourdomain.com>"
# Staff notification address (receives a link only — never applicant answers)
CASTING_NOTIFY_EMAIL=
PRESS_NOTIFY_EMAIL=

# ── Bot protection (optional — Cloudflare Turnstile) ─────────
# Without these, honeypot + timing checks + rate limits still apply.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Policy ───────────────────────────────────────────────────
# Days after submission that "Not Selected" applications may be purged from the admin.
CASTING_RETENTION_DAYS=365
